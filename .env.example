# Neon PostgreSQL Database URL (Pooled for runtime queries)
# Format: postgresql://[user]:[password]@[neon-hostname]-pooler.[region].aws.neon.tech/[database]?sslmode=require
DATABASE_URL="postgresql://[user]:[password]@[neon-hostname]-pooler.[region].aws.neon.tech/[database]?sslmode=require"

# Neon PostgreSQL Direct Connection URL (Unpooled for migrations)
# Format: postgresql://[user]:[password]@[neon-hostname].[region].aws.neon.tech/[database]?sslmode=require
DIRECT_URL="postgresql://[user]:[password]@[neon-hostname].[region].aws.neon.tech/[database]?sslmode=require"

# Better Auth Secret (Generate a strong 32+ character random string, e.g. via `openssl rand -base64 32`)
BETTER_AUTH_SECRET="your-32-character-secret-key-here"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
BETTER_AUTH_URL="http://localhost:3000"
